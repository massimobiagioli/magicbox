# {{ ansible_managed }}
# Kong declarative configuration (DB-less), loaded at start (ADR-0015).
# Routes are HTTPS only; plain HTTP gets a 301 to HTTPS. Upstreams are on
# 127.0.0.1, so their certificates are not verified (traffic stays on the host).
_format_version: "3.0"

services:
{% for route in stacks_kong_all_routes %}
  - name: {{ route.name }}
    url: {{ route.url }}
    connect_timeout: 10000
    read_timeout: {{ stacks_kong_upstream_timeout * 1000 }}
    write_timeout: {{ stacks_kong_upstream_timeout * 1000 }}
    routes:
      - name: {{ route.name }}
        paths: ["{{ route.path }}"]
        strip_path: {{ route.strip | lower }}
        preserve_host: {{ route.preserve_host | lower }}
        protocols: [https]
        https_redirect_status_code: 301
{% if route.key_auth | default(false) %}
        # Streamed responses (token by token) are passed through unbuffered.
        response_buffering: false
        plugins:
          - name: key-auth
            config:
              key_names: [apikey]
              # The key is not forwarded to the upstream.
              hide_credentials: true
{% endif %}
{% endfor %}

  # Redirects only; the upstream is never contacted.
  - name: redirects
    url: http://127.0.0.1:9
    routes:
      # "/" opens Portainer.
      - name: root
        paths: ["~/$"]
        protocols: [https]
        https_redirect_status_code: 301
        plugins:
          - name: pre-function
            config:
              access:
                - kong.response.exit(301, nil, { Location = "/portainer/" })
{% for route in stacks_kong_all_routes | selectattr('slash', 'defined') | selectattr('slash') %}
      # The UI loads its assets relative to the page: it needs the slash.
      - name: {{ route.name }}-slash
        paths: ["~{{ route.path | regex_replace('/$', '') }}$"]
        protocols: [https]
        https_redirect_status_code: 301
        plugins:
          - name: pre-function
            config:
              access:
                - kong.response.exit(301, nil, { Location = "{{ route.path }}" })
{% endfor %}
{% for redirect in stacks_kong_port_redirects %}
      # UI on its own port (see stacks_kong_port_redirects).
      - name: {{ redirect.name }}-redirect
        paths: ["~{{ redirect.path }}/?$"]
        protocols: [https]
        https_redirect_status_code: 301
        plugins:
          - name: pre-function
            config:
              access:
                - kong.response.exit(301, nil, { Location = "{{ redirect.location }}" })
{% endfor %}

consumers:
  - username: ollama-client
    keyauth_credentials:
      - key: {{ stacks_kong_ollama_api_key | to_json }}
