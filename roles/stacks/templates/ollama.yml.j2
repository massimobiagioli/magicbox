# {{ ansible_managed }}
# Ollama LLM runtime (CPU inference). The API has no authentication.
services:
  ollama:
    image: {{ stacks_ollama_image }}
    container_name: ollama
    restart: unless-stopped
    ports:
      - "{{ stacks_ollama_port }}:11434"
    volumes:
      - ollama_data:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

volumes:
  ollama_data:
    name: ollama_data
