# {{ ansible_managed }}
# Jenkins Configuration as Code. Applied at every start: changes made in the
# UI to these settings are overwritten. ${name} values are read from files in
# /run/secrets (written by Ansible from the vault).
jenkins:
  systemMessage: "MagicBox CI/CD - configured by Ansible (playbooks/ci-cd.yml)"
  # Builds never run on the controller: it holds the credentials.
  numExecutors: 0
  mode: EXCLUSIVE
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: admin
          password: "${jenkins_admin_password}"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  remotingSecurity:
    enabled: true
  nodes:
    - permanent:
        name: docker-agent
        labelString: docker
        numExecutors: {{ stacks_jenkins_agent_executors }}
        remoteFS: /home/jenkins/agent
        retentionStrategy: always
        launcher:
          ssh:
            host: jenkins-agent
            port: 22
            credentialsId: jenkins-agent-ssh
            javaPath: /opt/java/openjdk/bin/java
            # Host key generated by Ansible and pinned here: a recreated agent
            # keeps the same key, a different one is refused.
            sshHostKeyVerificationStrategy:
              manuallyProvidedKeyVerificationStrategy:
                key: "{{ stacks_jenkins_agent_host_key }}"

unclassified:
  location:
    url: "https://{{ magicbox_hostname }}.local:{{ stacks_jenkins_port }}/"

credentials:
  system:
    domainCredentials:
      - credentials:
          - basicSSHUserPrivateKey:
              scope: SYSTEM
              id: jenkins-agent-ssh
              description: Controller -> agent SSH key (generated by Ansible)
              username: jenkins
              privateKeySource:
                directEntry:
                  privateKey: "${readFile:/run/secrets/agent_ssh_key}"
{% if stacks_jenkins_github_token | length > 0 %}
          - usernamePassword:
              scope: GLOBAL
              id: github
              description: GitHub fine-grained token (vault_jenkins_github_token)
              username: "{{ stacks_jenkins_github_user }}"
              password: "${github_token}"
{% endif %}
{% if stacks_jenkins_portainer_token | length > 0 %}
          - string:
              scope: GLOBAL
              id: portainer-api-token
              description: Portainer API token (vault_jenkins_portainer_token)
              secret: "${portainer_api_token}"
{% endif %}
