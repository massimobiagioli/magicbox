# {{ ansible_managed }}
# Jenkins build agent: SSH agent + Docker CLI (talks to the MagicBox engine
# through the mounted socket) + uv + git/make.
FROM {{ stacks_jenkins_docker_cli_image }} AS docker-cli
FROM {{ stacks_jenkins_uv_image }} AS uv

FROM {{ stacks_jenkins_agent_base_image }}
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
 && apt-get install -y --no-install-recommends git make curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY agent-entrypoint.sh /usr/local/bin/magicbox-agent-entrypoint
RUN chmod 0755 /usr/local/bin/magicbox-agent-entrypoint
ENTRYPOINT ["/usr/local/bin/magicbox-agent-entrypoint"]
