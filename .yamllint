---
extends: default
ignore: |
  .venv/
  .ansible/
  .serena/
  inventory/group_vars/magicbox/vault.yml
rules:
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
